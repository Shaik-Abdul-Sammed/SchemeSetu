# SchemeSetu Backend Configuration (Render / Production / Development)

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_sih2026

# Frontend & CORS Configuration (URL of deployed frontend on Render)
FRONTEND_URL=https://schemesetu-frontend.onrender.com
CORS_ORIGIN=https://schemesetu-frontend.onrender.com

# Optional ML Microservice Integration (Fallback ML is built-in)
ML_SERVICE_URL=http://localhost:5001

# Optional Database Connection (In-memory datasets active by default)
DATABASE_URL=postgresql://username:password@localhost:5432/schemesetu

# Optional Email / Notification Service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
