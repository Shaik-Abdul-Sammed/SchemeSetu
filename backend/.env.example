# For demo/dev, only .env.example defaults are needed. For production, DATABASE_URL and SMTP_* are required for persistence and email.
# SchemeSetu Backend Configuration (Render / Production / Development)

# Server Configuration
PORT=5000                                 # [REQUIRED] Port for Express server
HOST=0.0.0.0                              # [OPTIONAL] Binding host IP
NODE_ENV=development                      # [REQUIRED] development | production | test

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_sih2026 # [REQUIRED] Secret key for signing citizen and agent JWT tokens

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173        # [OPTIONAL] URL of client web application
CORS_ORIGIN=http://localhost:5173         # [OPTIONAL] Allowed origins for CORS

# Optional Machine Learning Service Integration (Fallback heuristic ML built-in)
ML_SERVICE_URL=http://localhost:5001      # [OPTIONAL] External AI/ML inference service

# Database Connection (In-memory datasets active by default for zero-setup demo)
DATABASE_URL=postgresql://username:password@localhost:5432/schemesetu # [OPTIONAL for dev, REQUIRED for production persistence]

# Email / Notification Service (In-memory mock logger active by default)
SMTP_HOST=smtp.example.com                # [OPTIONAL for dev, REQUIRED for production email delivery]
SMTP_PORT=587                             # [OPTIONAL]
SMTP_USER=user@example.com                # [OPTIONAL]
SMTP_PASS=password                        # [OPTIONAL]
